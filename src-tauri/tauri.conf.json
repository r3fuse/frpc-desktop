{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "frpc-desktop",
    "version": "0.1.0",
    "identifier": "com.rec.frpc-desktop",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "width": 900,
                "height": 700,
                "decorations": false,
                "transparent": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/logo128.png"],
        "externalBin": ["binaries/frpc"],
        "resources": ["resources/frpc.toml"]
    }
}
